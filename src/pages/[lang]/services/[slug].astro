---
import Landing from '../../../components/pages/Landing.astro';
import { site, type Lang } from '../../../config/site';
import { getLandingSlugs } from '../../../lib/content';

// One page per landing file and language other than the default one, which lives at the top level.
export async function getStaticPaths() {
  const slugs = await getLandingSlugs();
  return (Object.keys(site.locales) as Lang[])
    .filter((lang) => lang !== site.defaultLang)
    .flatMap((lang) => slugs.map((slug) => ({ params: { lang: site.locales[lang].path.replaceAll('/', ''), slug }, props: { lang } })));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { slug } = Astro.params;
---

<Landing lang={lang} slug={slug} />
