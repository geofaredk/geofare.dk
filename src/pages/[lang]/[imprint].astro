---
import Imprint from '../../components/pages/Imprint.astro';
import { site, type Lang } from '../../config/site';

// One imprint per language other than the default one, which lives at the top level, under the
// language's own word for it (`/da/kolofon/`).
export function getStaticPaths() {
  return (Object.keys(site.locales) as Lang[])
    .filter((lang) => lang !== site.defaultLang)
    .map((lang) => ({ params: { lang: site.locales[lang].path.replaceAll('/', ''), imprint: site.locales[lang].routes.imprint }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Imprint lang={lang} />
