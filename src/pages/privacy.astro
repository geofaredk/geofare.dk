---
import { render } from 'astro:content';
import { site } from '../config/site';
import Base from '../layouts/Base.astro';
import { getSection } from '../lib/content';

const lang = 'en';
const page = await getSection(lang, 'privacy');
const { Content } = await render(page);
---

<Base lang={lang} title={`${page.data.title} | ${site.name}`} noindex>
  <section class="section">
    <div class="container">
      <h1 class="claim">{page.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Base>
