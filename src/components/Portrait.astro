---
// The 4:5 portrait slot. Until there is a photo it shows a crop of the line field;
// pass `src` (an imported image) and `alt` and the photo takes its place, same size.
// The place that uses the slot decides how wide it is.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LineField from './LineField.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** How wide the slot is drawn, for the browser's choice of image file. The default is the About section's slot. */
  sizes?: string;
}

const { src, alt = '', sizes = '(min-width: 86rem) 31rem, (min-width: 48rem) 36vw, 16rem' } = Astro.props;
---

<div class="portrait">
  {
    src ? (
      <Image src={src} alt={alt} widths={[320, 480, 640, 960]} sizes={sizes} />
    ) : (
      /* Drawn at the hero's scale and line spacing (wide screens), as large as the slot gets (31rem). */
      <LineField width={496} height={620} time={22} spacing={28} actualSize />
    )
  }
</div>

<style>
  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .portrait > :global(*) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
