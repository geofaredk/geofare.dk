---
// The picture in the About section: a window onto the moving line field, and overlapping its
// upper right the 4:5 picture, which stands out above it. Until there is a photo the picture is a placeholder showing
// `placeholder`; pass `src` (an imported image) and `alt` and the photo takes its place, same size.
// The place that uses the component decides how wide the whole thing is.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FieldWindow from './FieldWindow.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Shown in the picture's place until there is a photo; from the content files. */
  placeholder?: string;
  /** How wide the picture is drawn, for the browser's choice of image file. The default is the About section's. */
  sizes?: string;
}

const { src, alt = '', placeholder = '', sizes = '(min-width: 86rem) 19rem, (min-width: 48rem) 23vw, 10rem' } = Astro.props;
---

<div class="portrait">
  {/* The window onto the moving field; its still, for no JavaScript, is drawn at the hero's scale. */}
  <FieldWindow width={496} height={620} time={22} spacing={28} class="portrait__window" />
  <div class="portrait__picture">
    {
      src ? (
        /* Shown at 10 to 19rem wide, so 640 px covers a double-density screen. */
        <Image src={src} alt={alt} width={640} widths={[320, 480, 640]} sizes={sizes} />
      ) : (
        <p class="portrait__placeholder">{placeholder}</p>
      )
    }
  </div>
</div>

<style>
  /* The picture stands top right; the window sits lower on the left, so the picture overlaps its
     upper right and stands out above it. Sizes are shares of the block's width. */
  .portrait {
    position: relative;
    /* Keeps the window's top margin inside, so it pushes the window down and not the whole block. */
    display: flow-root;
  }

  .portrait__window {
    position: relative;
    width: 90%;
    aspect-ratio: 4 / 5;
    /* How far the picture stands out above the window. */
    margin-block-start: 34%;
    clip-path: inset(0 round var(--radius));
  }

  .portrait__picture {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 62%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    /* A quiet tint of the accent, solid, so the lines behind it do not show through. */
    background-color: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }

  .portrait__picture > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    color: var(--ink-muted);
    font-size: var(--step-small);
    text-align: center;
  }
</style>
