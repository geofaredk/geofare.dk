---
// The 4:5 portrait slot. Until there is a photo it shows a crop of the line field;
// pass `src` (an imported image) and `alt` and the photo takes its place, same size.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LineField from './LineField.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
}

const { src, alt = '' } = Astro.props;
---

<div class="portrait">
  {
    src ? (
      <Image src={src} alt={alt} widths={[320, 480, 640, 960]} sizes="(min-width: 48rem) 32vw, 100vw" />
    ) : (
      <LineField width={400} height={500} time={22} />
    )
  }
</div>

<style>
  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .portrait > :global(*) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
