---
import { render } from 'astro:content';
import { site, type Lang } from '../../config/site';
import { getSection } from '../../lib/content';
import { emailLink, linkedinLink } from '../../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const section = await getSection(lang, 'contact');
const { Content } = await render(section);
const links = [emailLink(site.company.email), linkedinLink(site.company.linkedin)];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">{section.data.title}</h2>
    <Content />
    <ul class="contact__links">
      {
        links.map((link) => (
          <li>
            {link.href ? (
              <a href={link.href} rel={link.external ? 'external' : undefined}>
                {link.label}
              </a>
            ) : (
              <span>{link.label}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__links {
    padding: 0;
    list-style: none;
    font-size: var(--step-lead);
  }
</style>
