---
import { render } from 'astro:content';
import type { Lang } from '../../config/site';
import { getSection } from '../../lib/content';
import Portrait from '../Portrait.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [mission, founder, quote, team] = await Promise.all(
  (['about-mission', 'about-founder', 'about-quote', 'about-team'] as const).map(async (id) => {
    const entry = await getSection(lang, id);
    return { title: entry.data.title, ...(await render(entry)) };
  }),
);
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container cols">
    <h2 id="about-title" class="claim about__claim">{mission.title}</h2>
    <div class="lead about__mission">
      <mission.Content />
    </div>

    {/* The founder's photo goes here: import it and pass it as `src`, with its `alt` text from the content files. */}
    <div class="about__portrait">
      <Portrait />
    </div>

    {/* One column of text beside the picture: who he is, what he says, how the work is staffed. */}
    <div class="about__column">
      <div class="about__text">
        <h3>{founder.title}</h3>
        <founder.Content />
      </div>

      <figure class="about__quote">
        <blockquote>
          <quote.Content />
        </blockquote>
      </figure>

      <div class="about__text">
        <h3>{team.title}</h3>
        <team.Content />
      </div>
    </div>
  </div>
</section>

<style>
  .about__mission {
    margin-block-start: 1.75rem;
  }

  /* The slot is a small picture until it has a column of its own; the same holds for a photo. */
  .about__portrait {
    max-width: 16rem;
    margin-block-start: calc(var(--section-space) * 0.6);
  }

  .about__column {
    margin-block-start: 2rem;
  }

  .about__column > * + * {
    margin-block-start: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .about__text {
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .about__text h3 {
    margin-block-end: 0.75rem;
    color: var(--ink);
    font-size: var(--step-title);
    line-height: 1.2;
  }

  /*
   * The founder's own words, set apart by size, colour and weight. The opening mark hangs
   * in the margin, so the words themselves start on the edge the text around them starts on:
   * the first line is pulled out by the width of that mark, a third of an em in Figtree.
   */
  .about__quote {
    color: var(--accent);
    font-size: var(--step-claim-s);
    font-weight: var(--weight-medium);
    line-height: 1.18;
    letter-spacing: var(--tracking-claim);
    text-wrap: balance;
  }

  .about__quote :global(p) {
    text-indent: -0.33em;
  }

  /*
   * A spread: the claim across the top, then the picture in columns 1 to 5 and one column of
   * text on the page's middle edge. The picture's top is the founder heading's top; the
   * quote stands beside the picture, at a size that sets in three or four lines there.
   */
  @media (width >= 48rem) {
    .about__claim {
      grid-column: 1 / span 10;
    }

    .about__mission,
    .about__column {
      grid-column: 7 / -1;
    }

    .about__mission {
      margin-block-start: 2.5rem;
    }

    .about__portrait {
      grid-column: 1 / span 5;
      align-self: start;
      max-width: none;
    }

    .about__column {
      margin-block-start: calc(var(--section-space) * 0.6);
    }

    .about__quote {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
      line-height: 1.22;
    }
  }

  @media (width >= 64rem) {
    .about__claim {
      grid-column: 1 / span 9;
    }
  }
</style>
