---
import { site, type Lang } from '../../config/site';
import { contactCta, mainNav } from '../../config/navigation';
import { getUi } from '../../lib/content';
import { localizePath, switchPath } from '../../lib/i18n';
import Button from '../Button.astro';
import Logo from '../Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await getUi(lang);

// The language switcher leads to the same page in the other language; from a page that exists
// once for the whole site (the 404 page) it leads to that language's home page.
const here = /^\/404/.test(Astro.url.pathname) ? '/' : Astro.url.pathname;
const languages = (Object.keys(site.locales) as Lang[]).map((code) => ({
  code,
  locale: site.locales[code],
  href: switchPath(here, code),
}));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={localizePath('/', lang)} class="site-header__home">
      <Logo alt={ui.home} />
    </a>
    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
      data-open={ui.nav.menuOpen}
      data-close={ui.nav.menuClose}>{ui.nav.menuOpen}</button
    >
    <nav id="site-menu" class="site-header__menu" aria-label={ui.nav.label}>
      <ul class="site-header__links">
        {
          mainNav.map((item) => (
            <li>
              <a href={localizePath(item.href, lang)}>{ui.nav[item.id]}</a>
            </li>
          ))
        }
      </ul>
      <Button href={localizePath(contactCta.href, lang)}>{ui.nav[contactCta.id]}</Button>
      <ul class="site-header__langs" aria-label={ui.lang.label}>
        {
          languages.map(({ code, locale, href }) => (
            <li>
              {code === lang ? (
                <span class="site-header__lang" aria-current="true" lang={locale.htmlLang}>
                  {locale.short}
                  <span class="sr-only"> {locale.name}</span>
                </span>
              ) : (
                <a class="site-header__lang" href={href} lang={locale.htmlLang} hreflang={locale.hreflang}>
                  {locale.short}
                  <span class="sr-only"> {locale.name}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../../scripts/menu';
</script>

<style>
  /* Exactly --header-h tall, so anchors and focus can be kept clear of it (scroll-padding-top). */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    height: var(--header-h);
    background-color: var(--bg);
  }

  /* Logo and menu stand on one line: the foot of the logo is the baseline of the menu text.
     The row as a whole is centred in the header. */
  .site-header__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* The logo's drawing fills its file from top to bottom, so the bottom edge of this link is the
     foot of the logo, and that edge is the line the menu text sits on. */
  /*
   * The logo file is 1280 × 320 units: the mark fills the height, and the wordmark's capitals run
   * from 98 to 222 (124 units tall) and stand on a baseline at 220. The logo is drawn at the height
   * that makes those capitals exactly as tall as the menu text's (Figtree's capitals are 0.7 em),
   * and the link's box ends on the wordmark's baseline, which is the line the menu text stands on
   * (the header aligns its row on that baseline). The mark's lower part hangs below the box.
   */
  .site-header__home {
    --logo-h: calc(var(--step-body) * 0.7 * 320 / 124);
    position: relative;
    display: block;
    flex: none;
    height: calc(var(--logo-h) * 220 / 320);
  }

  /* The target covers the whole logo, the part hanging below the box included, plus a margin
     that makes it at least 44 px tall. */
  .site-header__home::after {
    content: '';
    position: absolute;
    inset: -0.75rem 0 calc(-0.75rem - 100% * 100 / 220);
  }

  .site-header__home :global(.logo) {
    display: block;
    width: auto;
    height: var(--logo-h);
  }

  .site-header__menu,
  .site-header__links {
    display: flex;
    align-items: center;
    gap: 0.5rem clamp(1.25rem, 2.6vw, 2.5rem);
  }

  .site-header__links {
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms;
  }

  .site-header__links a:hover {
    color: var(--accent);
  }

  /* The language switcher: short names side by side, the current one in the accent colour. */
  .site-header__langs {
    display: flex;
    align-items: center;
    padding: 0;
    list-style: none;
  }

  .site-header__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.75rem;
    color: var(--ink-muted);
    font-size: var(--step-small);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color 120ms;
  }

  a.site-header__lang:hover {
    color: var(--accent);
  }

  .site-header__lang[aria-current] {
    color: var(--accent);
  }

  /* In the bar the switcher is the last thing on the right: its last word ends on the page's edge. */
  @media (width >= 77rem) {
    .site-header__langs li:last-child .site-header__lang {
      justify-content: flex-end;
      min-width: 1.75rem;
    }
  }

  .site-header__toggle {
    display: none;
  }

  /* Small screens: the links wait behind a text button, on a cream sheet below the header. */
  @media (scripting: enabled) and (width < 77rem) {
    .site-header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0;
      border: 0;
      background: none;
      color: var(--ink);
      font-weight: var(--weight-medium);
      cursor: pointer;
      transition: color 120ms;
    }

    .site-header__toggle:hover {
      color: var(--accent);
    }

    .site-header__menu {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      height: calc(100dvh - var(--header-h));
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
      padding: 1.5rem var(--gutter) 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--bg);
    }

    .site-header__toggle[aria-expanded='true'] + .site-header__menu {
      display: flex;
    }

    .site-header__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      font-size: var(--step-title);
    }

    /* A short word such as "Lab" is still a full-size target. */
    .site-header__links a {
      min-width: 2.75rem;
    }

    /* In the sheet the languages start on the same edge as the links above them. */
    .site-header__lang {
      justify-content: flex-start;
      min-width: 3rem;
      font-size: var(--step-body);
    }
  }

  /* Small screens without JavaScript: no button; the links simply wrap under the logo. */
  @media (scripting: none) and (width < 77rem) {
    .site-header {
      position: static;
      height: auto;
    }

    .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.875rem 1rem;
    }

    .site-header__menu,
    .site-header__links {
      flex-wrap: wrap;
    }
  }
</style>
