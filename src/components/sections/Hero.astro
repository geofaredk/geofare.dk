---
import { render } from 'astro:content';
import type { Lang } from '../../config/site';
import { contactCta, mainNav } from '../../config/navigation';
import { getSection } from '../../lib/content';
import { localizePath } from '../../lib/i18n';
import Button from '../Button.astro';
import LineField from '../LineField.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const hero = await getSection(lang, 'hero');
const { fixed, endings, primaryCta, secondaryCta } = hero.data;
if (!fixed || !endings || !primaryCta || !secondaryCta) {
  throw new Error(`sections/${lang}/hero.md needs fixed, endings, primaryCta and secondaryCta`);
}
const servicesHref = mainNav.find((item) => item.id === 'services')!.href;
const { Content } = await render(hero);
---

<section id="top" class="hero">
  <canvas class="hero__field" aria-hidden="true"></canvas>
  {/* <canvas class="hero__field hero__field--fourth" aria-hidden="true"></canvas> */}
  {/* <canvas class="hero__field hero__field--second" aria-hidden="true"></canvas> */}
  <canvas class="hero__field hero__field--third" aria-hidden="true"></canvas>
  {/* <canvas class="hero__field hero__field--fifth" aria-hidden="true"></canvas> */}
  <canvas class="hero__field hero__field--sixth" aria-hidden="true"></canvas>

  <div class="container hero__head">
    {/* The h1 holds the final sentence and nothing else, so that is what every reader and crawler gets. */}
    <h1 class="hero__title">
      <span class="hero__fixed">{fixed}</span>{' '}
      <span class="hero__final">{endings.at(-1)}</span>
    </h1>
    {/* The rotation is a hidden layer beside it, set in the same type, standing where the final line stands. */}
    <div class="hero__rotator" aria-hidden="true">
      {
        endings.map((ending, i) => (
          <>
            <span class="hero__ending" data-active={i === 0 ? '' : undefined}>
              {ending}
            </span>{' '}
          </>
        ))
      }
    </div>
  </div>

  {/* Without JavaScript the free middle of the hero shows the same field, standing still. */}
  <noscript><LineField width={1440} height={320} class="hero__still" /></noscript>

  <div class="container hero__foot">
    <div class="hero__lede">
      <div class="hero__sub"><Content /></div>
      <p class="hero__actions">
        <Button href={localizePath(contactCta.href, lang)}>{primaryCta}</Button>
        <Button href={localizePath(servicesHref, lang)} variant="secondary">{secondaryCta}</Button>
      </p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero';
</script>

<style>
  /* Three rows: the headline, free space where the field is densest, then sub-line and buttons. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto minmax(2.5rem, 1fr) auto;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(2.5rem, 14svh, 9rem) clamp(1.5rem, 4.5svh, 3rem);
  }

  /* The field covers the whole hero, behind everything in it. */
  .hero__field {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 60%;
    height: 90%;
  }

  .hero__field--fourth {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 60%;
    height: 90%;
    transform: scale(-1, 1);
  }

  .hero__field--second {
    top: auto;
    left: auto;
    right: 0;
    bottom: 0;
    width: 37%;
    height: 55%;
    transform: scale(-1, 1);
  }

  .hero__field--third {
    top: auto;
    left: auto;
    right: 0;
    bottom: 0;
    width: 37%;
    height: 55%;
  }

  .hero__field--fifth {
    position: absolute;
    top: 0;
    right: 0;
    left: auto;
    z-index: -1;
    width: 30%;
    height: 30%;
    transform: scale(-1, 1);
  }

  .hero__field--sixth {
    position: absolute;
    top: 0;
    right: 0;
    left: auto;
    z-index: -1;
    width: 30%;
    height: 30%;
  }

  /* A centred container is a grid item with auto margins, which would otherwise shrink to its content. */
  .hero__head,
  .hero__foot {
    width: 100%;
  }

  .hero__head {
    grid-row: 1;
  }

  /* Headline: the h1 and the rotating layer below it are set as one piece of type. */
  .hero__title,
  .hero__rotator {
    color: var(--accent);
    font-size: var(--step-hero);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .hero__fixed,
  .hero__final {
    display: block;
  }

  .hero__rotator {
    display: none;
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    /* Out of sight but still the h1's text, as with .sr-only; the rotator takes its place on the next line. */
    .hero__final {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* All endings share one cell, so the slot is always as tall as the tallest and nothing below moves. */
    .hero__rotator {
      display: grid;
    }

    /* An ending leaves upwards as it fades; the next one rises into its place. 500 ms in all. */
    .hero__ending {
      grid-area: 1 / 1;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.2em);
      transition:
        opacity 260ms ease-in,
        transform 260ms ease-in,
        visibility 0s 260ms;
    }

    .hero__ending[data-active] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    /* The first ending is simply there when the page loads. */
    .hero__ending[data-active]:not(:first-child) {
      animation: hero-ending-in 300ms ease-out 200ms backwards;
    }

    @keyframes hero-ending-in {
      from {
        opacity: 0;
        transform: translateY(0.2em);
      }
    }
  }

  /* Without JavaScript: the same field as a still, in the free middle row only, never behind text. */
  @media (scripting: none) {
    .hero > :global(noscript) {
      position: relative;
      display: block;
      grid-row: 2;
      min-height: 9rem;
      margin-block: 2rem;
    }

    .hero__still {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }

  /* Sub-line and buttons bottom left */
  .hero__foot {
    grid-row: 3;
  }

  /* Only as wide as the sub-line and buttons, so the field is cleared behind them and no further. */
  .hero__lede {
    width: fit-content;
  }

  .hero__sub {
    /* 38ch of Figtree, in em so the fallback face (narrower digits) wraps the line the same way. */
    max-width: 24.35em;
    font-size: var(--step-lead);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.75rem;
  }

  /* Phones: both buttons share one row and fill it; where even that is too narrow they stack, full width. */
  @media (width < 30rem) {
    .hero__lede {
      width: auto;
    }

    .hero__actions {
      gap: 0.5rem;
    }

    .hero__actions > :global(.button) {
      flex: 1 1 auto;
      padding-inline: 1rem;
    }
  }
</style>
