---
import { render } from 'astro:content';
import type { Lang } from '../../config/site';
import { getPrinciples, getSection } from '../../lib/content';
import LineField from '../LineField.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const section = await getSection(lang, 'approach');
const principles = await Promise.all(
  (await getPrinciples(lang)).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<section id="approach" class="approach" aria-labelledby="approach-title">
  <div class="container">
    <h2 id="approach-title" class="signpost">{section.data.title}</h2>
    {/* role="list": Safari drops list semantics once the markers are styled away. */}
    <ul class="principles" role="list">
      {
        principles.map(({ entry, Content }) => (
          <li class="principle">
            <h3>{entry.data.title}</h3>
            <div class="principle__body">
              <Content />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  {/* The field runs along the foot of the section, below the text, never behind it. Drawn at the hero's scale, wider than any screen. */}
  <LineField width={2560} height={176} time={41} actualSize class="approach__field" />
</section>

<style>
  /* The one blue section. Everything on it is --on-accent, the focus ring included. */
  .approach {
    padding-block-start: var(--section-space);
    background-color: var(--accent);
    color: var(--on-accent);
  }

  .approach h2,
  .approach h3 {
    color: var(--on-accent);
  }

  .approach :global(:focus-visible) {
    outline-color: var(--on-accent);
  }

  /* The signpost belongs to the row beneath it: a third of the space that stands above it. */
  .principles {
    display: grid;
    row-gap: 2.5rem;
    margin-block-start: calc(var(--section-space) / 3);
    padding: 0;
    list-style: none;
  }

  .principle h3 {
    margin-block-end: 0.75rem;
    font-size: var(--step-claim-s);
    letter-spacing: var(--tracking-claim);
  }

  .principle__body {
    max-width: 30ch;
    text-wrap: pretty;
  }

  /*
   * Side by side, each principle lends its two rows (name, text) to the grid, so the texts
   * start on one line even if a name wraps. The gap between rows of principles is the
   * grid's own, so a fifth principle starts a new row at the same distance.
   */
  @media (width >= 40rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: 3.5rem;
    }

    .principle {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }

  /* Four columns are narrow: the names take a size at which the longest still sets on one line. */
  @media (width >= 64rem) {
    .principles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .principle h3 {
      font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    }
  }

  .approach__field {
    width: 100%;
    height: clamp(6.5rem, 13vw, 11rem);
    margin-block-start: calc(var(--section-space) * 0.6);
    color: var(--on-accent);
    opacity: 0.3;
  }
</style>
