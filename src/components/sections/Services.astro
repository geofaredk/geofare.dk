---
import { render } from 'astro:content';
import type { Lang } from '../../config/site';
import { getSection, getServices } from '../../lib/content';
import Tag from '../Tag.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const section = await getSection(lang, 'services');
const services = await Promise.all(
  (await getServices(lang)).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const number = (order: number) => String(order).padStart(2, '0');
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="signpost">{section.data.title}</h2>
    {/* role="list": Safari drops list semantics once the markers are styled away. */}
    <ol class="services" role="list">
      {
        services.map(({ entry, Content }) => (
          <li class="service">
            <p class="service__number">{number(entry.data.order)}</p>
            <h3 class="service__title">{entry.data.title}</h3>
            <div class="service__body">
              <Content />
            </div>
            <ul class="service__tags" role="list">
              {entry.data.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    display: grid;
    row-gap: 4rem;
    margin-block-start: calc(var(--section-space) / 2);
    padding: 0;
    list-style: none;
  }

  /* The number says where the block stands in the sequence: see, know, decide, explain. */
  .service__number {
    color: var(--accent);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .service__title {
    margin-block-start: 0.5rem;
    font-size: var(--step-claim-s);
    letter-spacing: var(--tracking-claim);
  }

  .service__body {
    max-width: var(--measure);
    margin-block-start: 1rem;
    text-wrap: pretty;
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.5rem;
    margin-block-start: 1.75rem;
    padding: 0;
    list-style: none;
  }

  /*
   * Two by two, in halves of the 12-column grid, so the second column starts on the page's
   * middle edge; the space between the columns is each block's own right-hand margin.
   * Each block lends its four rows to the grid, so across a pair the claims, the texts
   * and the tags start on the same lines however the claim beside them wraps.
   */
  @media (width >= 48rem) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: 0;
    }

    .service {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      padding-inline-end: clamp(1rem, 6vw - 1.5rem, 5.5rem);
    }

    .service:nth-child(n + 3) {
      margin-block-start: 6rem;
    }
  }
</style>
