---
// A service landing page: one content file per language holds the whole page; this component
// only knows the order of the sections and what each needs.
import { render } from 'astro:content';
import { site, type Lang } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { getLanding, getLandingPages, getUi } from '../../lib/content';
import { anchorId, localizePath, routePath } from '../../lib/i18n';
import { landingStructuredData } from '../../lib/landing-seo';
import founderPhoto from '../../assets/founder.png';
import Clients from '../sections/Clients.astro';
import Contact from '../sections/Contact.astro';
import LandingHero from '../landing/LandingHero.astro';
import Situations from '../landing/Situations.astro';
import Offer from '../landing/Offer.astro';
import Process from '../landing/Process.astro';
import Audiences from '../landing/Audiences.astro';
import Why from '../landing/Why.astro';
import Faq from '../landing/Faq.astro';

interface Props {
  lang: Lang;
  /** The file name, shared by the languages. */
  name: string;
}

const { lang, name } = Astro.props;
const ui = await getUi(lang);
const page = await getLanding(lang, name);
const { data } = page;
const { Content: Lead } = await render(page);
// This page in every language, each under its own URL, for the switcher and the hreflang links.
const paths = Object.fromEntries(
  (await getLandingPages()).filter((other) => other.name === name).map((other) => [other.lang, routePath('services', other.lang, other.slug)]),
) as Record<Lang, string>;

// The sections this page's buttons lead to, under their ids in this language.
const contactAnchor = `#${anchorId('contact', lang)}`;
const offerAnchor = `#${anchorId('offer', lang)}`;

const absolute = (path: string) => new URL(path, site.url).href;
const structuredData = landingStructuredData({
  name: data.service,
  description: data.meta.description,
  url: absolute(Astro.url.pathname),
  providerName: site.name,
  providerUrl: absolute(localizePath('/', lang)),
  faq: data.faq.items,
});
---

<Base lang={lang} title={data.meta.title} description={data.meta.description} structuredData={structuredData} contactHref={contactAnchor} headerTone="accent" paths={paths}>
  <LandingHero
    lang={lang}
    title={data.title}
    primaryCta={data.hero.primaryCta}
    secondaryCta={data.hero.secondaryCta}
    primaryHref={contactAnchor}
    secondaryHref={offerAnchor}
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
  >
    <Lead />
  </LandingHero>
  <Clients lang={lang} title={data.clients.title} spacing="own" />
  <Situations lang={lang} data={data.situations} />
  <Offer lang={lang} data={data.offer} />
  <Process lang={lang} data={data.process} />
  <Audiences lang={lang} data={data.audiences} />
  <Why lang={lang} data={data.why} photo={founderPhoto} photoAlt={ui.about.portraitAlt} />
  <Faq lang={lang} data={data.faq} />
  <Contact lang={lang} title={data.contact.title} body={data.contact.body} />
</Base>
