---
// Who the service is for: openable rows as the home page's sectors, one per audience, each with
// the sentence that names their question and the points that answer it. The first starts open.
import type { Lang } from '../../config/site';
import { anchorId } from '../../lib/i18n';

interface Props {
  lang: Lang;
  data: { title: string; intro: string; items: { title: string; lead: string; points: string[] }[] };
}

const { lang, data } = Astro.props;
---

<section id={anchorId('audiences', lang)} class="section" aria-labelledby="audiences-title">
  <div class="container">
    <h2 id="audiences-title" class="claim">{data.title}</h2>
    <p class="lead audiences__intro">{data.intro}</p>
    {/* Plain <details>: every audience's text is in the HTML and opens without JavaScript. */}
    <div class="audiences">
      {
        data.items.map((item, i) => (
          <details class="audience" open={i === 0}>
            <summary class="audience__summary">
              <h3 class="audience__name">{item.title}</h3>
              <span class="audience__sign" aria-hidden="true" />
            </summary>
            <div class="cols audience__panel">
              <p>{item.lead}</p>
              <ul>
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .audiences__intro {
    max-width: var(--measure);
    margin-block-start: 1.75rem;
  }

  /* The hairlines are the rows' edges: one above each row, one below the last. */
  .audiences {
    margin-block-start: calc(var(--section-space) / 2);
    border-block-end: 1px solid var(--rule);
  }

  .audience {
    border-block-start: 1px solid var(--rule);
  }

  /* The whole row is the target. `display: flex` also removes the browser's own marker. */
  .audience__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    list-style: none;
    cursor: pointer;
  }

  .audience__summary::-webkit-details-marker {
    display: none;
  }

  .audience__name {
    color: var(--ink);
    font-size: var(--step-claim-s);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-claim);
    transition: color 120ms;
  }

  /* A plus drawn with two bars; the upright one goes when the row is open, leaving a minus. */
  .audience__sign {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ink);
    transition: color 120ms;
  }

  .audience__sign::before,
  .audience__sign::after {
    content: '';
    position: absolute;
    background-color: currentColor;
  }

  .audience__sign::before {
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
  }

  .audience__sign::after {
    inset: 0 auto 0 calc(50% - 1px);
    width: 2px;
  }

  .audience[open] .audience__sign::after {
    display: none;
  }

  /* Forced colours paint backgrounds as Canvas, which would erase the bars: draw them in the text colour. */
  @media (forced-colors: active) {
    .audience__sign::before,
    .audience__sign::after {
      background-color: CanvasText;
      forced-color-adjust: none;
    }
  }

  .audience__summary:hover > *,
  .audience[open] > .audience__summary > * {
    color: var(--accent);
  }

  .audience__panel {
    row-gap: 1.5rem;
    padding-block: 0.5rem clamp(2.5rem, 5vw, 4rem);
  }

  .audience__panel p {
    max-width: 34ch;
    font-size: var(--step-lead);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* A string marker, not `none`, so the list stays a list for assistive tech in every browser. */
  .audience__panel ul {
    padding-inline-start: 1.05em;
    list-style: '–\2002';
  }

  .audience__panel li {
    text-wrap: pretty;
  }

  .audience__panel li + li {
    margin-block-start: 0.5rem;
  }

  .audience__panel li::marker {
    color: var(--accent);
  }

  @media (width >= 56rem) {
    .audience__panel p {
      grid-column: 1 / span 5;
    }

    .audience__panel ul {
      grid-column: 7 / -1;
      padding-block-start: 0.15em;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) and selector(::details-content) {
      .audience {
        interpolate-size: allow-keywords;
      }

      .audience::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size 240ms ease-out,
          content-visibility 240ms allow-discrete;
      }

      .audience[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
