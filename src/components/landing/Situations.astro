---
// The situations a visitor will recognise: a claim, a lead, then a grid of named situations,
// set as the principles of the home page's blue section are, on cream.
import type { Lang } from '../../config/site';
import { anchorId } from '../../lib/i18n';

interface Props {
  lang: Lang;
  data: { title: string; intro: string; items: { title: string; body: string }[] };
}

const { lang, data } = Astro.props;
---

<section id={anchorId('situations', lang)} class="section" aria-labelledby="situations-title">
  <div class="container">
    <h2 id="situations-title" class="claim">{data.title}</h2>
    <p class="lead situations__intro">{data.intro}</p>
    {/* role="list": Safari drops list semantics once the markers are styled away. */}
    <ul class="situations" role="list">
      {
        data.items.map((item) => (
          <li class="situation">
            <h3>{item.title}</h3>
            <p class="situation__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .situations__intro {
    max-width: var(--measure);
    margin-block-start: 1.75rem;
  }

  .situations {
    display: grid;
    row-gap: 2.5rem;
    margin-block-start: calc(var(--section-space) / 2);
    padding: 0;
    list-style: none;
  }

  .situation h3 {
    margin-block-end: 0.75rem;
    color: var(--ink);
    font-size: var(--step-title);
    line-height: 1.2;
  }

  .situation__body {
    max-width: 30ch;
    text-wrap: pretty;
  }

  /* Side by side, each situation lends its two rows (name, text) to the grid, so the texts start on one line. */
  @media (width >= 40rem) {
    .situations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: 3.5rem;
    }

    .situation {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }

  @media (width >= 64rem) {
    .situations {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
