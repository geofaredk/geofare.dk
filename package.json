{
  "name": "geofare-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "astro build && vitest run",
    "pretest:e2e": "astro build",
    "test:e2e": "playwright test --project=chrome --project=webkit",
    "pretest:e2e:firefox": "astro build",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:firefox:docker": "bash tests/docker/e2e-firefox.sh",
    "test:docker": "bash tests/docker/smoke.sh",
    "lighthouse": "node scripts/lighthouse.mjs",
    "brand-assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
